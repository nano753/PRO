rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lfagundes192168@gmail.com'
      );
    }

    // Products: any signed-in user can read (PDV / Consulta); writes allowed for signed-in users
    match /products/{productId} {
      allow read, write: if isSignedIn() || isSuperAdmin();
    }

    // Categories: signed-in users can read and manage
    match /categories/{categoryId} {
      allow read, write: if isSignedIn() || isSuperAdmin();
    }

    // Movements: stock entries and exits
    match /movements/{movementId} {
      allow read, write: if isSignedIn() || isSuperAdmin();
    }

    // Sales: PDV checkout sales
    match /sales/{saleId} {
      allow read, write: if isSignedIn() || isSuperAdmin();
    }

    // Cash Registers: POS cash registers
    match /cashRegisters/{registerId} {
      allow read, write: if isSignedIn() || isSuperAdmin();
    }

    // Settings: company settings and fiscal information
    match /settings/{settingId} {
      allow read, write: if isSignedIn() || isSuperAdmin();
    }

    // Users: system users
    match /users/{userId} {
      allow read, write: if isSignedIn() || isSuperAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
